{
  "name": "@batak-dev/recording-sdk",
  "version": "0.2.12",
  "description": "Extensible, resilient WebCodecs video-recording SDK: adaptive quality, signed chunked upload, offline queue, service-worker background sync, and resilience telemetry.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": "./dist/network.js"
    },
    "./resilience": {
      "types": "./dist/resilience.d.ts",
      "import": "./dist/resilience.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./sw": {
      "types": "./dist/sw.d.ts",
      "import": "./dist/sw.js"
    },
    "./sw/worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./sw.default.js": "./dist/sw.default.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.sw.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@types/dom-mediacapture-transform": "^0.1.10",
    "@types/dom-webcodecs": "^0.1.13",
    "happy-dom": "^20.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
